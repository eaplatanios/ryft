---
const year = new Date().getFullYear();
---

<footer
  class="mt-24 border-t border-[var(--color-ryft-border)] py-8 text-sm text-[var(--color-ryft-fg-faint)]"
>
  <div
    class="mx-auto max-w-[1200px] px-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-3"
  >
    <div class="font-mono">
      © {year} Anthony Platanios · MIT or Apache-2.0
    </div>
    <div class="flex items-center gap-5">
      <a
        href="https://github.com/eaplatanios/ryft"
        class="hover:text-[var(--color-ryft-fg)] transition no-underline"
      >GitHub</a>
      <a
        href="https://docs.rs/ryft"
        class="hover:text-[var(--color-ryft-fg)] transition no-underline"
      >docs.rs</a>
      <a
        href="https://crates.io/crates/ryft"
        class="hover:text-[var(--color-ryft-fg)] transition no-underline"
      >crates.io</a>
    </div>
  </div>
</footer>
