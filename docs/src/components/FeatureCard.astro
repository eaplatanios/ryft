---
interface Props {
  title: string;
  href?: string;
}

const { title, href } = Astro.props;

const baseClasses =
  'block rounded-xl border border-[var(--color-ryft-border)] p-6 bg-[color-mix(in_srgb,var(--color-ryft-fg)_2%,var(--color-ryft-bg))] hover:border-[var(--color-ryft-border-strong)] transition no-underline';
---

{
  href ? (
    <a href={href} class={baseClasses}>
      <h3
        class="font-serif text-[1.15rem] font-semibold tracking-[-0.012em] text-[var(--color-ryft-fg)] mb-2"
      >
        {title}
      </h3>
      <p class="font-sans-ui text-[0.92rem] leading-[1.5] text-[var(--color-ryft-fg-muted)]">
        <slot />
      </p>
    </a>
  ) : (
    <div class={baseClasses}>
      <h3
        class="font-serif text-[1.15rem] font-semibold tracking-[-0.012em] text-[var(--color-ryft-fg)] mb-2"
      >
        {title}
      </h3>
      <p class="font-sans-ui text-[0.92rem] leading-[1.5] text-[var(--color-ryft-fg-muted)]">
        <slot />
      </p>
    </div>
  )
}
