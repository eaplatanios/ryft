---
import logoMarkup from '../assets/logo.svg?raw';
import ThemeToggle from './ThemeToggle.tsx';

const navLinks = [
  { href: '/get-started/', label: 'Get Started' },
  { href: '/book/', label: 'Book' },
  { href: '/examples/', label: 'Examples' },
  { href: 'https://docs.rs/ryft', label: 'API', external: true },
  { href: 'https://github.com/eaplatanios/ryft', label: 'GitHub', external: true },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--color-ryft-border)] bg-[color-mix(in_srgb,var(--color-ryft-bg)_85%,transparent)] backdrop-blur-md"
>
  <div class="mx-auto max-w-[1200px] px-6 h-16 flex items-center justify-between gap-6">
    <a
      href="/"
      class="flex items-center gap-2.5 no-underline text-[var(--color-ryft-fg)]"
    >
      <span
        class="inline-flex items-center justify-center w-7 h-7"
        aria-hidden="true"
        set:html={logoMarkup}
      />
      <span class="font-display uppercase tracking-[0.18em] text-[0.95rem] font-medium">Ryft</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-[0.92rem] font-medium text-[var(--color-ryft-fg-muted)]">
      {
        navLinks.map(({ href, label, external }) => (
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="hover:text-[var(--color-ryft-fg)] transition no-underline"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
    </div>
  </div>
</header>
