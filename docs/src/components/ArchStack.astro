---
/**
 * Layered crate-stack diagram. Each row is a labeled section: a role (left)
 * and the crates that play that role (right). Built from semantic HTML so it
 * stays accessible and adapts to both light and dark modes via CSS variables.
 */

interface Layer {
  role: string;
  crates: string[];
  note?: string;
  foundation?: boolean;
}

interface Props {
  layers: Layer[];
}

const { layers } = Astro.props;
---

<div
  role="img"
  aria-label="Ryft crate stack from umbrella down to the OpenXLA foundation."
  class="my-8 border border-[var(--color-ryft-border)] rounded-xl overflow-hidden bg-[color-mix(in_srgb,var(--color-ryft-fg)_2%,var(--color-ryft-bg))]"
>
  {
    layers.map((layer, i) => (
      <div
        class={`grid grid-cols-1 md:grid-cols-[13rem_1fr] ${
          i < layers.length - 1 ? 'border-b border-[var(--color-ryft-border)]' : ''
        } ${layer.foundation ? 'bg-[color-mix(in_srgb,var(--color-ryft-fg)_3%,transparent)]' : ''}`}
      >
        <div
          class="font-display uppercase tracking-[0.14em] text-[0.7rem] text-[var(--color-ryft-fg-muted)] py-4 px-5 md:border-r border-[var(--color-ryft-border)] bg-[color-mix(in_srgb,var(--color-ryft-fg)_3%,transparent)] flex items-center"
        >
          {layer.role}
        </div>
        <div class="py-4 px-5 flex flex-wrap items-center gap-x-5 gap-y-2">
          {layer.crates.map((c) => (
            <code class="font-mono text-[0.95rem] font-medium text-[var(--color-ryft-fg)] bg-transparent p-0">
              {c}
            </code>
          ))}
          {layer.note && (
            <span class="font-sans-ui text-[0.85rem] text-[var(--color-ryft-fg-muted)]">
              {layer.note}
            </span>
          )}
        </div>
      </div>
    ))
  }
</div>
