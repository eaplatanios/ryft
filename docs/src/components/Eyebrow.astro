---
/**
 * Section label that anchors each major segment of a page. Wide-tracked
 * Chakra Petch on a subtle hairline.
 */
---

<div
  class="font-display uppercase tracking-[0.18em] text-xs text-[var(--color-ryft-fg-muted)] mt-14 mb-3 flex items-center gap-3"
>
  <span class="block h-px w-6 bg-[color-mix(in_srgb,var(--color-ryft-fg)_18%,transparent)]"></span>
  <slot />
  <span class="block h-px flex-1 bg-[color-mix(in_srgb,var(--color-ryft-fg)_18%,transparent)]"></span>
</div>
