---
interface Props {
  href: string;
  variant?: 'primary' | 'minimal';
  external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 px-5 h-11 rounded-full text-[0.95rem] font-medium font-sans-ui transition no-underline';

const styles = {
  primary:
    'bg-[var(--color-ryft-fg)] text-[var(--color-ryft-bg)] hover:bg-[color-mix(in_srgb,var(--color-ryft-fg)_88%,var(--color-ryft-bg))]',
  minimal:
    'text-[var(--color-ryft-fg)] border border-[var(--color-ryft-border)] hover:border-[var(--color-ryft-border-strong)] hover:bg-[color-mix(in_srgb,var(--color-ryft-fg)_4%,transparent)]',
};
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class={`${base} ${styles[variant]}`}
>
  <slot />
  {
    variant === 'primary' && (
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7" />
      </svg>
    )
  }
  {
    external && (
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17L17 7M9 7h8v8" />
      </svg>
    )
  }
</a>
