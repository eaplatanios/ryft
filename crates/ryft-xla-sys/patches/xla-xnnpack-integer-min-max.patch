diff --git a/third_party/xnnpack/integer_min_max.patch b/third_party/xnnpack/integer_min_max.patch
--- /dev/null
+++ b/third_party/xnnpack/integer_min_max.patch
@@ -0,0 +1,40 @@
+diff --git a/ynnpack/base/arithmetic.h b/ynnpack/base/arithmetic.h
+--- a/ynnpack/base/arithmetic.h
++++ b/ynnpack/base/arithmetic.h
+@@ -37,22 +37,30 @@
+ // return a.
+ template <typename T>
+ T min(T a, T b) {
++  if constexpr (std::is_integral_v<T>) {
++    return a < b ? a : b;
++  } else {
+ #ifdef YNN_ARCH_HEXAGON
+-  // Work around a Hexagon Clang bug that lowers `a < b ? a : b` to `sfmin`,
+-  // which returns `a` when `b` is NaN.
+-  return (a < b && !isnan(b)) || isnan(a) ? a : b;
++    // Work around a Hexagon Clang bug that lowers `a < b ? a : b` to `sfmin`,
++    // which returns `a` when `b` is NaN.
++    return (a < b && !isnan(b)) || isnan(a) ? a : b;
+ #else
+-  return a < b || isnan(a) ? a : b;
++    return a < b || isnan(a) ? a : b;
+ #endif  // YNN_ARCH_HEXAGON
++  }
+ }
+ 
+ template <typename T>
+ T max(T a, T b) {
++  if constexpr (std::is_integral_v<T>) {
++    return a > b ? a : b;
++  } else {
+ #ifdef YNN_ARCH_HEXAGON
+-  return (a > b && !isnan(b)) || isnan(a) ? a : b;
++    return (a > b && !isnan(b)) || isnan(a) ? a : b;
+ #else
+-  return a > b || isnan(a) ? a : b;
++    return a > b || isnan(a) ? a : b;
+ #endif  // YNN_ARCH_HEXAGON
++  }
+ }
+ 
+ template <typename T>
