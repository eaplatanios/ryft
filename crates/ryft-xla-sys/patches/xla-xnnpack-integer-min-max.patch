diff --git a/third_party/xnnpack/integer_min_max.patch b/third_party/xnnpack/integer_min_max.patch
--- /dev/null
+++ b/third_party/xnnpack/integer_min_max.patch
@@ -0,0 +1,26 @@
+diff --git a/ynnpack/base/arithmetic.h b/ynnpack/base/arithmetic.h
+--- a/ynnpack/base/arithmetic.h
++++ b/ynnpack/base/arithmetic.h
+@@ -37,12 +37,20 @@
+ // return a.
+ template <typename T>
+ T min(T a, T b) {
+-  return a < b || isnan(a) ? a : b;
++  if constexpr (std::is_integral_v<T>) {
++    return a < b ? a : b;
++  } else {
++    return a < b || isnan(a) ? a : b;
++  }
+ }
+ 
+ template <typename T>
+ T max(T a, T b) {
+-  return a > b || isnan(a) ? a : b;
++  if constexpr (std::is_integral_v<T>) {
++    return a > b ? a : b;
++  } else {
++    return a > b || isnan(a) ? a : b;
++  }
+ }
+ 
+ template <typename T>
