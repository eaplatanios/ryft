   std::unique_ptr<llvm::orc::LLJIT> lljit = std::move(*lljit_or_error);
+
+  // Built-in runtime functions may be hidden in a locally loaded PJRT plugin.
+  // Bind their addresses in this JIT only, without exporting plugin internals or
+  // relying on process-wide dynamic-loader visibility.
+  llvm::orc::SymbolMap runtime_symbols;
+  runtime_symbols[lljit->mangleAndIntern("mosaic_gpu_init_tma_desc")] =
+      llvm::orc::ExecutorSymbolDef::fromPtr(&mosaic_gpu_init_tma_desc,
+                                          llvm::JITSymbolFlags::Exported);
+  runtime_symbols[lljit->mangleAndIntern("mosaic_gpu_init_tma_im2col_desc")] =
+      llvm::orc::ExecutorSymbolDef::fromPtr(&mosaic_gpu_init_tma_im2col_desc,
+                                          llvm::JITSymbolFlags::Exported);
+  runtime_symbols[lljit->mangleAndIntern("mosaic_gpu_build_kernel_spec")] =
+      llvm::orc::ExecutorSymbolDef::fromPtr(&mosaic_gpu_build_kernel_spec,
+                                          llvm::JITSymbolFlags::Exported);
+  if (auto err = lljit->getMainJITDylib().define(
+          llvm::orc::absoluteSymbols(std::move(runtime_symbols)))) {
+    return absl::InternalError(absl::StrFormat(
+        "failed to register Mosaic GPU runtime symbols: %s",
+        llvm::toString(std::move(err))));
+  }
 
