+  // Convert n' to an i32.  This is safe for numbers because we clamped it
+  // above, but the clamp leaves a NaN in place and FPToSI(NaN) yields poison in
+  // LLVM IR. Freezing the poison is not enough: an arbitrary n' makes rem_bits
+  // arbitrary too, and adding rem_bits to the bits of a NaN z yields a value
+  // that is no longer a NaN (e.g., -inf). Convert zero in place of a NaN
+  // instead, so that rem_bits is 0, pow2 is 1.0f, and the NaN in z reaches the
+  // result.
+  llvm::Value* n_is_nan = b->CreateFCmpUNO(n, n);
+  llvm::Value* n_or_zero = b->CreateSelect(
+      n_is_nan, llvm::Constant::getNullValue(n->getType()), n);
+  llvm::Value* n_i32 = b->CreateFPToSI(
+      n_or_zero, llvm::VectorType::get(b->getInt32Ty(), vector_width, false));
 
