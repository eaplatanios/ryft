    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "@llvm-project//mlir:include/mlir/Dialect/LLVMIR/Transforms/Passes.td",
    deps = [
        "@llvm-project//mlir:LLVMOpsTdFiles",
        "@llvm-project//mlir:PassBaseTdFiles",
