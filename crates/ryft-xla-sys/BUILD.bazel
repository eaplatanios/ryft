# The XLA LLVM Bazel overlay exposes Math and Vector pass C API declarations but omits their generated implementations.
# Generate those implementations from the same pinned TableGen sources so Rust bindings resolve from the native archive.
gentbl_cc_library(
    name = "arith_pass_capi_impl_inc_gen",
    tbl_outs = {
        "mlir/Dialect/Arith/Transforms/Passes.capi.cpp.inc": [
            "-gen-pass-capi-impl",
        ],
    },
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "@llvm-project//mlir:include/mlir/Dialect/Arith/Transforms/Passes.td",
    deps = ["@llvm-project//mlir:PassBaseTdFiles"],
)

gentbl_cc_library(
    name = "llvm_pass_capi_impl_inc_gen",
    tbl_outs = {
        "mlir/Dialect/LLVMIR/Transforms/Passes.capi.cpp.inc": [
            "-gen-pass-capi-impl",
